+import { describe, expect, it } from 'vitest'
+import { Box3 } from 'three'
+import { ARM_TOP, BACK_CENTER_Y, COLUMN_TOP, officeChairGeometries, SEAT_PAD, SEAT_TOP } from './chairModel'
+import { DESK_HEIGHT } from './officePlan'
+
+/** A cadeira no assento padrão: tudo derivado do SEAT_TOP, os braços abaixo do tampo. */
+describe('cadeira da estação', () => {
+  it('assento dentro da NBR 13962 (≥ 0,42) e abaixo do tampo com folga para as coxas', () => {
+    expect(SEAT_TOP).toBeGreaterThanOrEqual(0.42)
+    expect(DESK_HEIGHT + 0.025 - SEAT_TOP).toBeGreaterThan(0.27)
+  })
+
+  it('a coluna a gás para na base do estofado e os braços ficam 0,20–0,22 m acima do assento, abaixo do tampo', () => {
+    expect(COLUMN_TOP).toBeLessThanOrEqual(SEAT_TOP - 0.14)
+    expect(ARM_TOP).toBeGreaterThanOrEqual(SEAT_TOP + 0.2)
+    expect(ARM_TOP).toBeLessThanOrEqual(SEAT_TOP + 0.22)
+    expect(ARM_TOP).toBeLessThan(DESK_HEIGHT - 0.025)
+  })
+
+  it('a geometria segue as constantes: estofado até SEAT_TOP, metal até ARM_TOP, encosto em volta de BACK_CENTER_Y', () => {
+    const { top, base } = officeChairGeometries()
+    const upholstery = new Box3().setFromBufferAttribute(top.attributes.position as never)
+    const metal = new Box3().setFromBufferAttribute(base.attributes.position as never)
+    // O encosto (0,64 de altura, inclinado) é o ponto mais alto do estofado; o assento, o mais baixo.
+    expect(upholstery.min.y).toBeCloseTo(SEAT_TOP - SEAT_PAD, 3)
+    expect(upholstery.max.y).toBeGreaterThan(BACK_CENTER_Y + 0.3)
+    expect(upholstery.max.y).toBeLessThan(BACK_CENTER_Y + 0.34)
+    // O metal: os rodízios no chão; os braços (|x| > 0,29, acima da base) com o topo em ARM_TOP.
+    expect(metal.min.y).toBeGreaterThanOrEqual(0)
+    expect(metal.min.y).toBeLessThan(0.02)
+    const pos = base.attributes.position
+    let armTop = 0
+    for (let i = 0; i < pos.count; i++) if (Math.abs(pos.getX(i)) > 0.29 && pos.getY(i) > 0.2) armTop = Math.max(armTop, pos.getY(i))
+    expect(armTop).toBeCloseTo(ARM_TOP, 3)
+    expect(metal.max.y).toBeLessThan(BACK_CENTER_Y)
+    top.dispose()
+    base.dispose()
+  })
+})
