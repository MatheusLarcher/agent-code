diff --git a/src/renderer/src/office3d/seatedReach.test.ts b/src/renderer/src/office3d/seatedReach.test.ts
new file mode 100644
index 0000000..020a73e
--- /dev/null
+++ b/src/renderer/src/office3d/seatedReach.test.ts
@@ -0,0 +1,81 @@
+/**
+ * Ergonomia sentado na cadeira da estação, para cada corpo que senta nela: o
+ * boneco (BODY, ×1 e ×0,85) e os avatares GLB do elenco (abertos pelo
+ * avatarGlbTestKit e preparados pelo prepareAvatar do app, com as medidas e a
+ * escala de cada um). Digitando (a IK do typing, keysReach de reach.ts), o
+ * punho chega às teclas sem esticar o braço inteiro e o antebraço fica perto
+ * da horizontal; as pernas (sitLower) põem o quadril sobre o assento e o
+ * joelho sob o tampo. Pega a cadeira alta de novo (0,59) ou um avatar novo de
+ * braço curto.
+ */
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { prepareAvatar } from './agentRest'
+import { AVATAR_DIR, AVATAR_ROLES, buildScene, readGlb } from './avatarGlbTestKit'
+import { BODY, CH, newPose, SEAT_HEIGHT, sitLower, type BodyMetrics } from './poses'
+import { DESK_TOP, keysReach } from './reach'
+
+/** As inclinações do tronco pedidas pelo `type` e pelo `typeFast` (gestures.ts). */
+const LEANS = [0.1, 0.16]
+/** Folga mínima até o braço esticado inteiro (m) e o antebraço mais inclinado aceito (±20°). */
+const MIN_SLACK = 0.01
+const MAX_FOREARM = (20 * Math.PI) / 180
+/** A face de baixo do tampo (a placa de 0,05 centrada em DESK_HEIGHT, decorIslands.ts) e o topo do joelho acima da junta. */
+const DESK_UNDER = DESK_TOP - 0.05
+const KNEE_TOP = 0.06
+const deg = (r: number): string => `${((r * 180) / Math.PI).toFixed(1)}°`
+
+function seatedChecks(name: string, scale: number, b: BodyMetrics): void {
+  for (const lean of LEANS) {
+    it(`${name}: digitando com lean ${lean}, o punho chega às teclas sem esticar o braço e o antebraço quase na horizontal`, () => {
+      const r = keysReach(lean, scale, b)
+      const why = `${name} lean ${r.lean.toFixed(2)}: folga ${(r.slack * 100).toFixed(1)} cm, antebraço ${deg(r.forearm)}`
+      expect(r.slack, why).toBeGreaterThanOrEqual(MIN_SLACK)
+      expect(Math.abs(r.forearm), why).toBeLessThanOrEqual(MAX_FOREARM)
+    })
+  }
+
+  it(`${name}: o quadril fica sobre o assento e o joelho sob o tampo`, () => {
+    for (const vary of [0, 0.5, 1]) {
+      const out = newPose()
+      sitLower(out, 'chair', 0, scale, vary, b)
+      const hip = b.pelvisY + out[CH.pelvisY] - b.hipDrop
+      expect(hip * scale).toBeGreaterThan(SEAT_HEIGHT.chair)
+      for (const leg of [out[CH.legL], out[CH.legR]]) {
+        const knee = (hip - b.thigh * Math.cos(leg)) * scale
+        expect(knee + KNEE_TOP, `${name} vary ${vary}: joelho a ${knee.toFixed(3)} m`).toBeLessThan(DESK_UNDER)
+      }
+    }
+  })
+}
+
+describe('assento e tampo da estação', () => {
+  it('o assento da cadeira dentro da NBR 13962 (0,42–0,52) e o tampo entre 0,72 e 0,78', () => {
+    expect(SEAT_HEIGHT.chair).toBeGreaterThanOrEqual(0.42)
+    expect(SEAT_HEIGHT.chair).toBeLessThanOrEqual(0.52)
+    expect(DESK_TOP).toBeGreaterThanOrEqual(0.72)
+    expect(DESK_TOP).toBeLessThanOrEqual(0.78)
+  })
+
+  it('a conta bate com a medição do plano (boneco ×1, lean 0,1: o tronco não muda e o antebraço sobe +14°)', () => {
+    const r = keysReach(0.1)
+    expect(r.lean).toBe(0.1)
+    expect((r.forearm * 180) / Math.PI).toBeCloseTo(14, 0)
+  })
+})
+
+describe('boneco sentado', () => {
+  seatedChecks('boneco ×1', 1, BODY)
+  seatedChecks('boneco ×0,85', 0.85, BODY)
+})
+
+for (const role of AVATAR_ROLES) {
+  const path = join(AVATAR_DIR, `${role}.glb`)
+  describe.runIf(existsSync(path))(`avatar ${role}.glb sentado`, () => {
+    const { json, bin } = readGlb(path)
+    const t = prepareAvatar(buildScene(json, bin).scene)
+    if (typeof t === 'string') throw new Error(`prepareAvatar recusou ${role}: ${t}`)
+    seatedChecks(role, t.fit, t.metrics)
+  })
+}
