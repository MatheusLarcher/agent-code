index 0000000..47781e9
--- /dev/null
+++ b/src/renderer/src/office3d/seatedReach.test.ts
@@ -0,0 +1,81 @@
+/**
+ * Ergonomia de quem senta na cadeira da estação, avatar por avatar: o boneco
+ * (escalas 1 e 0,85) e cada GLB de resources/office-agents (aberto como no
+ * agentCast.test.ts, com as medidas e a escala do prepareAvatar) alcançam o
+ * teclado em `type` e `typeFast` sem esticar o braço inteiro, com o antebraço
+ * quase na horizontal (±20°), o quadril sobre o assento, os joelhos sob o
+ * tampo e os pés no chão. Com a cadeira alta de antes (assento a 0,59) o braço
+ * esticava para baixo até o teclado: este teste falha nela.
+ */
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { prepareAvatar } from './agentRest'
+import { DESK_HEIGHT } from './officePlan'
+import { BODY, CH, newPose, SEAT_HEIGHT, sitLower, type BodyMetrics } from './poses'
+import { DESK_TOP, KEYS_AHEAD, reachInfo } from './reach'
+import { AVATAR_DIR, buildScene, readGlb } from './testGlb'
+
+const ROLES = ['executor', 'critico', 'navegador-de-codigo', 'memoria', 'po', 'vigia', 'subagente', 'principal', 'central']
+/** A inclinação do tronco das ações de digitar (gestures.ts, `type` e `typeFast`). */
+const LEANS = [
+  ['type', 0.1],
+  ['typeFast', 0.16]
+] as const
+const MAX_FOREARM = (20 * Math.PI) / 180
+const deg = (rad: number): string => `${((rad * 180) / Math.PI).toFixed(1)}°`
+
+function avatar(role: string): { body: BodyMetrics; scale: number } {
+  const { json, bin } = readGlb(join(AVATAR_DIR, `${role}.glb`))
+  const t = prepareAvatar(buildScene(json, bin).scene)
+  if (typeof t === 'string') throw new Error(`prepareAvatar recusou ${role}: ${t}`)
+  return { body: t.metrics, scale: t.fit }
+}
+
+function seatedFits(body: BodyMetrics, scale: number): void {
+  // Mãos no teclado (a mesma IK do typing, reach.ts): o punho no alvo sem o braço esticado e o antebraço quase horizontal.
+  for (const [action, lean] of LEANS) {
+    const r = reachInfo(DESK_TOP + 0.055, KEYS_AHEAD, lean, scale, body)
+    expect(r.reached, `${action}: folga de ${(r.slack * 100).toFixed(1)} cm até o braço esticado`).toBe(true)
+    expect(Math.abs(r.forearm), `${action}: antebraço a ${deg(r.forearm)} da horizontal`).toBeLessThanOrEqual(MAX_FOREARM)
+  }
+  // Pernas (sitLower na cadeira): cada jeito de sentar (`vary`) e a troca de apoio ao longo do tempo.
+  const p = newPose()
+  for (const vary of [0, 0.5, 1]) {
+    for (const t of [0, 7, 13]) {
+      sitLower(p, 'chair', t, scale, vary, body)
+      const hip = body.pelvisY + p[CH.pelvisY] - body.hipDrop
+      expect(hip * scale, 'quadril sobre o assento').toBeGreaterThan(SEAT_HEIGHT.chair)
+      for (const [leg, kn] of [
+        [CH.legL, CH.kneeL],
+        [CH.legR, CH.kneeR]
+      ] as const) {
+        const knee = hip - body.thigh * Math.cos(p[leg])
+        const ankle = knee - body.shin * Math.cos(p[leg] - p[kn])
+        expect(knee * scale, `joelho sob o tampo (vary ${vary})`).toBeLessThan(DESK_HEIGHT - 0.025)
+        // O pé no chão: o tornozelo na altura dele em pé, ou pouco acima com a ponta do pé no chão (canela longa).
+        expect(ankle - body.ankleY, `tornozelo no chão (vary ${vary})`).toBeGreaterThan(-1e-3)
+        expect((ankle - body.ankleY) * scale, `tornozelo no chão (vary ${vary})`).toBeLessThan(0.04)
+      }
+    }
+  }
+}
+
+describe('ergonomia sentada: cada um alcança o teclado com o antebraço quase horizontal', () => {
+  it('as alturas no padrão: o assento (NBR 13962, 0,42–0,52) e o tampo (0,72–0,78)', () => {
+    expect(SEAT_HEIGHT.chair).toBeGreaterThanOrEqual(0.42)
+    expect(SEAT_HEIGHT.chair).toBeLessThanOrEqual(0.52)
+    expect(DESK_TOP).toBeGreaterThanOrEqual(0.72)
+    expect(DESK_TOP).toBeLessThanOrEqual(0.78)
+  })
+
+  it.each([1, 0.85])('o boneco na escala %s', (scale) => seatedFits(BODY, scale))
+
+  for (const role of ROLES) {
+    const path = join(AVATAR_DIR, `${role}.glb`)
+    it.runIf(existsSync(path))(`o avatar ${role}.glb`, () => {
+      const a = avatar(role)
+      seatedFits(a.body, a.scale)
+    })
+  }
+})
diff --git a/src/renderer/src/office3d/testGlb.ts b/src/renderer/src/office3d/testGlb.ts
new file mode 100644
index 0000000..c0706bc
--- /dev/null
+++ b/src/renderer/src/office3d/testGlb.ts
@@ -0,0 +1,97 @@
+/**
+ * Só para os testes: abre os avatares GLB de resources/office-agents SEM o
+ * GLTFLoader (no vitest ele não carrega as imagens embutidas). O chunk JSON e
+ * o BIN viram uma cena three com os mesmos nós, ossos e a malha com pele (só
+ * as posições), que o prepareAvatar do app (agentRest.ts) aceita como no
+ * escritório. Usado por agentCast.test.ts e seatedReach.test.ts.
+ */
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { Bone, BufferAttribute, BufferGeometry, Group, Matrix4, Object3D, PropertyBinding, SkinnedMesh } from 'three'
+
+export interface GltfNode {
+  name?: string
+  children?: number[]
+  mesh?: number
+  skin?: number
+  matrix?: number[]
+  translation?: number[]
+  rotation?: number[]
+  scale?: number[]
+}
+
+export interface Gltf {
+  scene?: number
+  scenes: Array<{ nodes: number[] }>
+  nodes: GltfNode[]
+  meshes: Array<{ primitives: Array<{ attributes: Record<string, number>; material?: number }> }>
+  skins?: Array<{ joints: number[]; inverseBindMatrices?: number }>
+  accessors: Array<{ bufferView?: number; byteOffset?: number; count: number; componentType: number; type: string }>
+  bufferViews: Array<{ byteOffset?: number; byteLength: number; byteStride?: number }>
+  materials?: Array<{ pbrMetallicRoughness?: { metallicRoughnessTexture?: { index: number } }; extras?: { tintMeanLuma?: number } }>
+}
+
+/** A pasta dos avatares (resources/office-agents/<papel>.glb). */
+export const AVATAR_DIR = join(process.cwd(), 'resources', 'office-agents')
+
+export function readGlb(path: string): { json: Gltf; bin: DataView } {
+  const buf = readFileSync(path)
+  const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength)
+  if (view.getUint32(0, true) !== 0x46546c67) throw new Error('não é GLB')
+  let json: Gltf | null = null
+  let bin: DataView | null = null
+  for (let off = 12; off + 8 <= buf.length; ) {
+    const len = view.getUint32(off, true)
+    const type = view.getUint32(off + 4, true)
+    if (type === 0x4e4f534a) json = JSON.parse(buf.subarray(off + 8, off + 8 + len).toString('utf8')) as Gltf
+    else if (type === 0x004e4942) bin = new DataView(buf.buffer, buf.byteOffset + off + 8, len)
+    off += 8 + len
+  }
+  if (!json || !bin) throw new Error('GLB sem JSON ou BIN')
+  return { json, bin }
+}
+
+const WIDTH: Record<string, number> = { SCALAR: 1, VEC2: 2, VEC3: 3, VEC4: 4, MAT4: 16 }
+
+/** Um accessor float (posições, matrizes inversas de bind), respeitando o byteStride. */
+export function floats(g: Gltf, bin: DataView, index: number): Float32Array {
+  const a = g.accessors[index]
+  if (a.componentType !== 5126 || a.bufferView === undefined) throw new Error(`accessor ${index} não é float`)
+  const bv = g.bufferViews[a.bufferView]
+  const n = WIDTH[a.type]
+  const stride = bv.byteStride || n * 4
+  const base = (bv.byteOffset ?? 0) + (a.byteOffset ?? 0)
+  const out = new Float32Array(a.count * n)
+  for (let i = 0; i < a.count; i++) for (let k = 0; k < n; k++) out[i * n + k] = bin.getFloat32(base + i * stride + k * 4, true)
+  return out
+}
+
+/** A cena como o GLTFLoader monta: junta = Bone, nó com malha e pele = SkinnedMesh, o resto = Object3D. */
+export function buildScene(g: Gltf, bin: DataView): { scene: Group; skinned: SkinnedMesh[]; jointNames: string[] } {
+  const joints = new Set((g.skins ?? []).flatMap((s) => s.joints))
+  const skinned: SkinnedMesh[] = []
+  const objs = g.nodes.map((n, i) => {
+    let o: Object3D
+    if (n.mesh !== undefined && n.skin !== undefined) {
+      const geo = new BufferGeometry()
+      geo.setAttribute('position', new BufferAttribute(floats(g, bin, g.meshes[n.mesh].primitives[0].attributes.POSITION), 3))
+      const mesh = new SkinnedMesh(geo)
+      skinned.push(mesh)
+      o = mesh
+    } else o = joints.has(i) ? new Bone() : new Object3D()
+    o.name = PropertyBinding.sanitizeNodeName(n.name ?? '')
+    if (n.matrix) new Matrix4().fromArray(n.matrix).decompose(o.position, o.quaternion, o.scale)
+    else {
+      if (n.translation) o.position.fromArray(n.translation)
+      if (n.rotation) o.quaternion.fromArray(n.rotation)
+      if (n.scale) o.scale.fromArray(n.scale)
+    }
+    return o
+  })
+  g.nodes.forEach((n, i) => n.children?.forEach((c) => objs[i].add(objs[c])))
+  const scene = new Group()
+  for (const i of g.scenes[g.scene ?? 0].nodes) scene.add(objs[i])
+  scene.updateMatrixWorld(true)
+  const jointNames = (g.skins?.[0]?.joints ?? []).map((j) => objs[j].name)
+  return { scene, skinned, jointNames }
+}
