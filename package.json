{
  "name": "agent-code-desktop",
  "version": "0.1.17",
  "description": "Desktop UI for Claude Code with an embedded agent-driven browser (Claude Desktop style)",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Larcher Tech",
  "scripts": {
    "dev": "npm run windows-control:build && electron-vite dev",
    "build": "electron-vite build && node scripts/build-storage-migration.mjs && npm run windows-control:build",
    "windows-control:build": "node scripts/build-windows-control.mjs",
    "windows-control:test": "dotnet run --project src/main/windowsControl/native/AgentCode.WindowsControl.csproj -c Release -- --self-test",
    "start": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "playwright install chromium",
    "package:win": "npm run build && node scripts/stage-chromium.mjs && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:pg": "node scripts/run-postgres-tests.mjs",
    "test:migrate-storage": "node --test scripts/migrate-storage.test.mjs",
    "migrate-storage": "node scripts/migrate-storage.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@typesafe-ai/sdk": "^0.6.0",
    "@xyflow/react": "^12.11.6",
    "highlight.js": "^11.11.1",
    "parquetjs-lite": "^0.8.7",
    "pg": "^8.23.0",
    "playwright": "^1.61.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
