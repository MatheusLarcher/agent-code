<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores do Agent Code (src/renderer/src/styles.css) e fontes do próprio Windows. -->
    <SolidColorBrush x:Key="Fundo" Color="#1F1E1D" />
    <SolidColorBrush x:Key="Fundo2" Color="#262624" />
    <SolidColorBrush x:Key="Fundo3" Color="#302E2C" />
    <SolidColorBrush x:Key="Linha" Color="#3A3836" />
    <SolidColorBrush x:Key="LinhaForte" Color="#55524E" />
    <SolidColorBrush x:Key="Texto" Color="#E8E6E3" />
    <SolidColorBrush x:Key="Mudo" Color="#A3A09B" />
    <SolidColorBrush x:Key="Acento" Color="#D97757" />
    <SolidColorBrush x:Key="AcentoClaro" Color="#E38665" />
    <SolidColorBrush x:Key="Ok" Color="#7FAE6F" />
    <SolidColorBrush x:Key="Erro" Color="#D97070" />
    <SolidColorBrush x:Key="ErroFraco" Color="#1FD97070" />
    <SolidColorBrush x:Key="Trilho" Color="#4A4744" />
    <FontFamily x:Key="FonteUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FonteMono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <!-- Ícones de traço (grade de 24). -->
    <Geometry x:Key="IconeTela">M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z M8,21 H16 M12,17 V21</Geometry>
    <Geometry x:Key="IconeComandos">M4,17 L10,11 L4,5 M12,19 H20</Geometry>
    <Geometry x:Key="IconeArquivos">M20,20 A2,2 0 0 0 22,18 V8 A2,2 0 0 0 20,6 H12.1 A2,2 0 0 1 10.4,5.1 L9.6,3.9 A2,2 0 0 0 7.9,3 H4 A2,2 0 0 0 2,5 V18 A2,2 0 0 0 4,20 Z</Geometry>
    <Geometry x:Key="IconeChrome">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M2,12 H22 M12,2 A15.3,15.3 0 0 1 16,12 A15.3,15.3 0 0 1 12,22 A15.3,15.3 0 0 1 8,12 A15.3,15.3 0 0 1 12,2 Z</Geometry>
    <Geometry x:Key="IconeCelular">M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M11,18 H13</Geometry>
    <Geometry x:Key="IconeAdministrador">M20,13 C20,18 16.5,20.5 12.3,21.95 A1,1 0 0 1 11.7,21.94 C7.5,20.5 4,18 4,13 V6 A1,1 0 0 1 5,5 C7,5 9.5,3.8 11.2,2.3 A1.2,1.2 0 0 1 12.8,2.3 C14.5,3.8 17,5 19,5 A1,1 0 0 1 20,6 Z</Geometry>
    <Geometry x:Key="IconeCopiar">M10,8 H20 A2,2 0 0 1 22,10 V20 A2,2 0 0 1 20,22 H10 A2,2 0 0 1 8,20 V10 A2,2 0 0 1 10,8 Z M4,16 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4</Geometry>
    <Geometry x:Key="IconeMinimizar">M1,5 H9</Geometry>
    <Geometry x:Key="IconeFechar">M1,1 L9,9 M9,1 L1,9</Geometry>

    <Style x:Key="Icone" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stroke" Value="{StaticResource Mudo}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Foco de teclado sempre visível. -->
    <Style x:Key="Foco">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{StaticResource Acento}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocoRedondo">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="14" RadiusY="14" Stroke="{StaticResource Acento}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Botao" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Background" Value="{StaticResource Fundo3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource FonteUi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoSim" TargetType="Button" BasedOn="{StaticResource Botao}">
        <Setter Property="Background" Value="{StaticResource Acento}" />
        <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
        <Setter Property="Foreground" Value="{StaticResource Fundo}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AcentoClaro}" />
                <Setter Property="BorderBrush" Value="{StaticResource AcentoClaro}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoFim" TargetType="Button" BasedOn="{StaticResource Botao}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Erro}" />
        <Setter Property="Foreground" Value="{StaticResource Erro}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ErroFraco}" />
                <Setter Property="BorderBrush" Value="{StaticResource Erro}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoLeve" TargetType="Button" BasedOn="{StaticResource Botao}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Mudo}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="36" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoBarra" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Fundo3}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chave liga/desliga de um recurso. -->
    <Style x:Key="Chave" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoRedondo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Trilho" CornerRadius="11" Background="{StaticResource Trilho}" />
                        <Ellipse x:Name="Bolinha" Width="16" Height="16" Fill="{StaticResource Texto}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trilho" Property="Background" Value="{StaticResource Ok}" />
                            <Setter TargetName="Bolinha" Property="Margin" Value="21,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Situacao" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Mudo}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style x:Key="Detalhe" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Mudo}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
</ResourceDictionary>
