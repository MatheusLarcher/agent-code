{
  "manifest_version": 3,
  "name": "Agent Code — Controle do Chrome",
  "short_name": "Agent Code",
  "version": "0.1.1",
  "description": "Permite que o Agent Code (app local) controle este Chrome. Fala só com 127.0.0.1.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Agent Code",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
